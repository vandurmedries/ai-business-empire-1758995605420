# Required: same value must be stored in the Roblox secret AI_BUSINESS_BACKEND_SECRET.
ROBLOX_SHARED_SECRET=replace-with-at-least-32-random-characters

# Required for admin summary and recommendation endpoints.
ADMIN_API_KEY=replace-with-an-independent-random-key

# Required by the Vercel cron request Authorization header.
CRON_SECRET=replace-with-an-independent-random-key

# Optional: without these, missions use deterministic local selection and events are not persisted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Safe experiments can be activated automatically only when this is explicitly true.
AUTO_APPLY_SAFE_EXPERIMENTS=false
MIN_OPERATOR_SESSIONS=50
